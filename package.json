{
  "name": "seo-content-outline-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "orchestrator-seo": "NODE_OPTIONS=--preserve-symlinks tsx scripts/orchestrator-seo-one-shot.ts",
    "e2e:human-gate": "NODE_OPTIONS=--preserve-symlinks tsx scripts/e2e-seo-article-human-gate.ts",
    "e2e:batch-reflection": "NODE_OPTIONS=--preserve-symlinks tsx scripts/e2e-batch-articles-reflection.ts",
    "test:banned-gate": "tsx scripts/test-banned-words-gate.ts",
    "test:similarity-gate": "tsx scripts/test-similarity-gate.ts && tsx scripts/test-published-corpus.ts",
    "test:article-type-gate": "tsx scripts/test-article-type-gate.ts",
    "start": "npm run server & npm run dev"
  },
  "dependencies": {
    "@google/genai": "^2.0.1",
    "@supabase/supabase-js": "^2.86.2",
    "@tailwindcss/typography": "^0.5.16",
    "@types/kuromoji": "^0.1.3",
    "dotenv": "^17.2.1",
    "googleapis": "^159.0.0",
    "js-yaml": "^4.1.0",
    "kuromoji": "^0.1.2",
    "openai": "^5.20.0",
    "parse5": "^8.0.0",
    "pdf-parse": "^1.1.1",
    "pdf-poppler": "^0.2.1",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.34.4",
    "tesseract.js": "^6.0.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.20.5",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
